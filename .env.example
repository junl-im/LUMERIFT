# LUMERIFT에는 공개 Firebase Web Config 기본값이 내장되어 있습니다.
# 다른 Firebase 프로젝트를 사용할 때만 아래 값을 설정하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Console > App Check에서 Web 앱을 등록한 뒤 reCAPTCHA v3 사이트 키를 입력합니다.
# 적용(enforcement)은 정상 요청 측정 후에 켜세요.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local Emulator Suite 사용 시 true
VITE_FIREBASE_USE_EMULATORS=false

VITE_DEFAULT_FPS_MODE=auto
VITE_ENABLE_DIAGNOSTICS=true
