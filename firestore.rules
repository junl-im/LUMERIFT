rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile(uid) {
      return owns(uid)
        && request.resource.data.keys().hasOnly([
          'saveVersion', 'uid', 'nickname', 'level', 'exp', 'highestStage', 'gold',
          'inventory', 'equipped', 'stageProgress', 'questClaims', 'dailyQuestDate',
          'dailyQuestClaims', 'statistics', 'dailyStatistics', 'tutorial', 'operations',
          'updatedAt', 'serverUpdatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.saveVersion is int
        && request.resource.data.saveVersion >= 4
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.exp is number
        && request.resource.data.exp >= 0
        && request.resource.data.highestStage is int
        && request.resource.data.highestStage >= 1
        && request.resource.data.highestStage <= 999
        && request.resource.data.gold is number
        && request.resource.data.gold >= 0
        && request.resource.data.inventory is map
        && request.resource.data.equipped is map
        && request.resource.data.stageProgress is map
        && request.resource.data.questClaims is map
        && request.resource.data.dailyQuestDate is string
        && request.resource.data.dailyQuestClaims is map
        && request.resource.data.statistics is map
        && request.resource.data.dailyStatistics is map
        && request.resource.data.tutorial is map
        && request.resource.data.operations is map
        && request.resource.data.updatedAt is number
        && request.resource.data.serverUpdatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if validProfile(uid);
      allow update: if validProfile(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;


      match /settings/{settingId} {
        function validCharacterAppearance() {
          return owns(uid)
            && settingId == 'characterAppearance'
            && request.resource.data.keys().hasOnly([
              'schema', 'ownerUid', 'updatedAt', 'revision', 'syncMode', 'archive', 'serverUpdatedAt'
            ])
            && request.resource.data.schema == 'lumerift-character-appearance-cloud-v2'
            && request.resource.data.ownerUid == uid
            && request.resource.data.updatedAt is int
            && request.resource.data.updatedAt > 0
            && request.resource.data.revision is string
            && request.resource.data.revision.matches('^appearance-[0-9a-f]{8}$')
            && request.resource.data.syncMode == 'manual-opt-in'
            && request.resource.data.archive is map
            && request.resource.data.archive.keys().hasOnly([
              'schemaVersion', 'game', 'kind', 'exportedAt', 'slotOrder', 'lockedSlots', 'slots', 'presets'
            ])
            && request.resource.data.archive.schemaVersion == 3
            && request.resource.data.archive.game == 'LUMERIFT'
            && request.resource.data.archive.kind == 'character-appearance-presets'
            && request.resource.data.archive.exportedAt is number
            && request.resource.data.archive.slotOrder is list
            && request.resource.data.archive.slotOrder.size() == 3
            && request.resource.data.archive.lockedSlots is map
            && request.resource.data.archive.slots is map
            && request.resource.data.archive.presets is list
            && request.resource.data.archive.presets.size() <= 5
            && request.resource.data.serverUpdatedAt == request.time;
        }

        allow get: if owns(uid) && settingId == 'characterAppearance';
        allow list: if false;
        allow create, update: if validCharacterAppearance();
        allow delete: if false;
      }

      match /mail/{mailId} {
        allow get, list: if owns(uid);
        allow create, delete: if false;
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt'])
          && request.resource.data.claimed == true
          && request.resource.data.claimedAt == request.time;
      }

      match /attendance/{cycleId} {
        allow get, list: if owns(uid);
        allow write: if false;
      }

      match /private/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /notices/{noticeId} {
      // 목록 쿼리는 where('published', '==', true)를 포함해야 합니다.
      // 게시 시작/종료 시각은 관리자 측에서 published 값을 전환해 관리합니다.
      allow get, list: if resource.data.published == true;
      allow write: if false;
    }

    match /gameConfig/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /rankings/{uid} {
      allow read: if true;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'score', 'stage', 'level', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 999999999
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 999
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }


    match /weeklyRankings/{entryId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'score', 'stage', 'level', 'weekKey', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && entryId == request.resource.data.weekKey + '_' + request.auth.uid
        && request.resource.data.weekKey is string
        && request.resource.data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 999999999
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 999
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /seasonRankings/{entryId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'score', 'stage', 'level', 'seasonId', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && entryId == request.resource.data.seasonId + '_' + request.auth.uid
        && request.resource.data.seasonId is string
        && request.resource.data.seasonId.matches('^S[0-9]{2,}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 999999999
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 999
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 쿠폰 원문과 보상은 클라이언트가 읽거나 쓰면 안 됩니다.
    // 안전한 쿠폰 지급은 Admin SDK 또는 Cloud Functions/Cloud Run에서 처리합니다.
    match /coupons/{document=**} {
      allow read, write: if false;
    }

    match /couponRedemptions/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
