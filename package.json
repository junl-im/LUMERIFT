{
  "name": "lumerift-web-rpg",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "verify": "npm run validate:config && npm run validate:firebase && npm run validate:account && npm run validate:combat && npm run typecheck && npm run validate:assets && npm run validate:data && npm run validate:atlas && npm run validate:manifest && npm run validate:asset-cleanup && npm run validate:art && npm run validate:archive && npm run validate:sourceart && npm run validate:ui && npm run validate:operations && npm run validate:mobile && npm run validate:mobile:v110 && npm run validate:liveart && npm run validate:source && npm run validate:handoff && npm run report:assets && npm run report:inventory && npm run report:asset-cleanup && npm run test && npm run build && npm run validate:bundle",
    "validate:source": "node scripts/check-source-imports.mjs",
    "validate:data": "node scripts/validate-game-data.mjs",
    "validate:atlas": "node scripts/validate-atlas.mjs",
    "report:assets": "node scripts/report-asset-budget.mjs",
    "validate:manifest": "node scripts/validate-asset-manifest.mjs",
    "validate:handoff": "node scripts/validate-handoff.mjs",
    "report:inventory": "node scripts/report-asset-inventory.mjs",
    "validate:art": "node scripts/validate-art-quality.mjs",
    "validate:config": "node scripts/validate-build-config.mjs",
    "validate:liveart": "node scripts/validate-live-art.mjs",
    "validate:archive": "node scripts/validate-full-archive-content.mjs",
    "validate:sourceart": "node scripts/validate-source-art.mjs",
    "validate:ui": "node scripts/validate-ui-rebuild.mjs",
    "validate:operations": "node scripts/validate-operations-ui.mjs",
    "validate:mobile": "node scripts/validate-mobile-layout.mjs",
    "validate:firebase": "node scripts/validate-firebase.mjs",
    "firebase:emulators": "npx firebase-tools emulators:start --project lumerift-8db07",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore --project lumerift-8db07",
    "firebase:deploy:firestore": "npx firebase-tools deploy --only firestore --project lumerift-8db07",
    "firebase:check": "npx firebase-tools projects:list",
    "validate:account": "node scripts/validate-account-cloud-ranking.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "firebase:test:rules": "npx firebase-tools emulators:exec --only auth,firestore --project lumerift-8db07 \"npm run test:rules\"",
    "asset:registry": "node scripts/generate-asset-registry.mjs",
    "asset:relocate": "node scripts/apply-asset-relocation.mjs",
    "validate:asset-cleanup": "node scripts/validate-asset-cleanup.mjs",
    "report:asset-cleanup": "node scripts/report-asset-cleanup.mjs",
    "validate:combat": "node scripts/validate-combat-presentation.mjs",
    "validate:mobile:v110": "node scripts/validate-mobile-ui-v110.mjs",
    "preverify": "node scripts/cleanup-relocated-assets.mjs",
    "cleanup:relocated-assets": "node scripts/cleanup-relocated-assets.mjs"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
